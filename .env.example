# Copy to .env. Change both secrets before starting.
APP_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password-before-start
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MOCK_MODE=true
ALLOW_SIGNUP=true
# Used only by the optional local runner profile.
ROUTER_PAIRING_CODE=
INSTALL_CODEX_CLI=false
INSTALL_AGY_CLI=false
RATE_LIMIT_COOLDOWN_SECONDS=300
CLI_TIMEOUT_SECONDS=180
CLI_TASK_TIMEOUT_SECONDS=3600
# Optional comma-separated CLI model slugs, checked against your installed CLI.
CODEX_MODELS=
AGY_MODELS=
# Set true when serving behind HTTPS with a trusted reverse proxy.
COOKIE_SECURE=false

# Telegram task control and notifications (dedicated bot created with BotFather)
TELEGRAM_BOT_TOKEN=
PUBLIC_URL=https://ai.s1m4.com

# Optional exact model IDs for automatic routing tiers (comma-separated).
AUTO_CHEAP_MODELS=
AUTO_STRONG_MODELS=

# Provider CLI updates in runner (latest stable releases, interval in seconds).
CLI_AUTO_UPDATE=true
CLI_UPDATE_INTERVAL_SECONDS=21600

# CCC early-level code generation shortcut; 0 disables it.
CCC_AUTO_FAST_LEVELS=2
