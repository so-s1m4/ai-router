{
  "name": "ai-router-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "AI Router chats with a lightweight Mac files and terminal bridge",
  "author": "AI Router",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "npm run prepare:runtime && electron-builder --mac --dir",
    "dist": "npm run prepare:runtime && electron-builder --mac dmg zip",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.airouter.desktop",
    "productName": "AI Router",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/runner",
        "to": "runner"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "assets/icon.icns"
    },
    "artifactName": "AI-Router-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "so-s1m4",
        "repo": "ai-router",
        "releaseType": "release"
      }
    ]
  }
}
