# Use your AI Router site URL. HTTPS is required outside local development.
ROUTER_SERVER_URL=https://router.example.com
# Create a one-time code on the site's Executors screen, paste here, then start the container.
ROUTER_PAIRING_CODE=
ROUTER_ALLOW_INSECURE=false
INSTALL_CODEX_CLI=false
INSTALL_AGY_CLI=false
MOCK_MODE=true
CLI_TIMEOUT_SECONDS=180
# Keep a warm Codex App Server per account for fast continuation and handoff.
CODEX_APP_SERVER_MODE=true
# Task mode can write within the runner container. Use workspace-write when nested sandboxing works on your host.
CODEX_TASK_SANDBOX=danger-full-access
